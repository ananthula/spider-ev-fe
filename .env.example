# WordPress.com headless CMS (blog source). Leave unset to use the default.
# Default: https://public-api.wordpress.com/wp/v2/sites/spiderenergy1.wordpress.com
# WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/spiderenergy1.wordpress.com

# Set to "false" to force local markdown in content/blog/ (skip CMS)
# WORDPRESS_CMS_ENABLED=true

# Set to "true" in the deployment environment so a CMS outage fails the build.
# An empty CMS feed retains the local archive so temporary content cleanup does
# not remove the existing blog from the site.
# WORDPRESS_CMS_REQUIRED=true

# Optional: only ingest posts assigned to this WordPress category slug.
# WORDPRESS_BLOG_CATEGORY_SLUG=ev-charging
