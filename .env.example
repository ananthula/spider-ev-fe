# WordPress headless CMS (blog source). Leave unset to use the default.
# Default: https://cms.spiderenergy.in/wp-json/wp/v2
# WORDPRESS_API_URL=https://cms.spiderenergy.in/wp-json/wp/v2

# Set to "false" to force local markdown in content/blog/ (skip CMS)
# WORDPRESS_CMS_ENABLED=true

# Set to "true" in the deployment environment so a CMS outage or empty feed
# fails the build instead of silently publishing stale local blog content.
# WORDPRESS_CMS_REQUIRED=true

# Optional: only ingest posts assigned to this WordPress category slug.
# WORDPRESS_BLOG_CATEGORY_SLUG=ev-charging
